# ==========================================
# Linen Line Store - Environment Variables
# ==========================================

# ------------------------------------------
# API Configuration
# ------------------------------------------
# Public API base URL accessible from both client and server
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Server-only API base URL (optional, if distinct from client-facing URL)
API_BASE_URL=https://api.example.com

# Optional request timeout for lib/api-client (milliseconds, default 15000)
API_TIMEOUT_MS=15000

# ------------------------------------------
# Firebase (client / FCM web push)
# ------------------------------------------
# Values from Firebase Console → Project settings → Your apps → Web app config.
# All NEXT_PUBLIC_* vars are exposed to the browser (required for the Firebase JS SDK).

NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456
# Optional — Google Analytics (Firebase JS SDK v7.20+)
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
# Web Push certificates (Cloud Messaging → Web Push certificates) — required for FCM
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your-web-push-vapid-key