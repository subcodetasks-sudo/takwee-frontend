# ==========================================
# Linen Line Store - Environment Variables
# ==========================================

# ------------------------------------------
# API Configuration
# ------------------------------------------
# Public API base URL accessible from both client and server
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Server-only API base URL (optional, if distinct from client-facing URL)
API_BASE_URL=https://api.example.com

# Optional request timeout for lib/api-client (milliseconds, default 15000)
API_TIMEOUT_MS=15000